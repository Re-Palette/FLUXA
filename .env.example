# ── Required ────────────────────────────────────────────────
DATABASE_URL="postgresql://fluxa:fluxa@localhost:5432/fluxa"
# Random string, 32+ chars. Signs OAuth state cookies.   openssl rand -base64 48
AUTH_SECRET=
# 32 bytes, base64. Encrypts API keys & OAuth tokens (AES-256-GCM). openssl rand -base64 32
# Never change it after credentials are stored (they would become unreadable).
ENCRYPTION_KEY=
APP_URL="http://localhost:3000"

# ── Google (Sign-In + Drive/Sheets/Gmail/Calendar connections) ──
# Authorized redirect URIs in Google Cloud Console:
#   {APP_URL}/api/auth/google/callback
#   {APP_URL}/api/connections/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Platform-funded AI (optional; default is BYOK — users connect their own keys) ──
PLATFORM_AI_ENABLED="false"
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional default model overrides
ANTHROPIC_DEFAULT_MODEL="claude-opus-5"
OPENAI_DEFAULT_MODEL="gpt-5"
GEMINI_DEFAULT_MODEL="gemini-2.5-pro"

# ── Scheduler / queue safety net: POST /api/cron/tick with "Authorization: Bearer $CRON_SECRET" ──
CRON_SECRET=
